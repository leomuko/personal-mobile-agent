CREATE TABLE attachment (
  position INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  id TEXT NOT NULL UNIQUE,
  name TEXT NOT NULL,
  mime_type TEXT NOT NULL,
  size INTEGER NOT NULL DEFAULT 0,
  status TEXT NOT NULL,
  message_id INTEGER REFERENCES message(id)
);

CREATE TABLE draft_epoch (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  epoch INTEGER NOT NULL
);

allAttachments:
SELECT * FROM attachment ORDER BY position;

insertAttachment:
INSERT INTO attachment(id, name, mime_type, status) VALUES (?, ?, ?, 'IMPORTING');

completeAttachment:
UPDATE attachment SET size = ?, status = 'READY' WHERE id = ? AND message_id IS NULL;

failAttachment:
UPDATE attachment SET status = 'FAILED' WHERE id = ?;

interruptImports:
UPDATE attachment SET status = 'FAILED' WHERE status = 'IMPORTING';

removeDraftAttachment:
DELETE FROM attachment WHERE id = ? AND message_id IS NULL;

attachToMessage:
UPDATE attachment SET message_id = ? WHERE message_id IS NULL;

clearAttachments:
DELETE FROM attachment;

readEpoch:
SELECT epoch FROM draft_epoch WHERE id = 1;

writeEpoch:
INSERT OR REPLACE INTO draft_epoch(id, epoch) VALUES (1, ?);

lastMessageId:
SELECT last_insert_rowid();
