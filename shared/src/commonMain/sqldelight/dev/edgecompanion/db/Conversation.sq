CREATE TABLE message (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  text TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  role TEXT NOT NULL DEFAULT 'USER',
  turn_id INTEGER,
  generation_id TEXT
);

CREATE UNIQUE INDEX message_generation_id ON message(generation_id);

CREATE TABLE assistant_attempt (
  id TEXT NOT NULL PRIMARY KEY,
  user_id INTEGER NOT NULL REFERENCES message(id),
  epoch INTEGER NOT NULL,
  status TEXT NOT NULL,
  error TEXT,
  context_epoch INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE draft (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  text TEXT NOT NULL
);

CREATE VIRTUAL TABLE message_search USING fts4(text TEXT);

CREATE INDEX message_created_at ON message(created_at);

-- S4: request scope per user turn and references-only consulted-passage provenance.
CREATE TABLE IF NOT EXISTS message_scope (
  message_id INTEGER NOT NULL PRIMARY KEY REFERENCES message(id),
  scope TEXT NOT NULL CHECK(scope IN ('ORDINARY', 'SOURCES'))
);
CREATE TABLE IF NOT EXISTS attempt_grounding (
  attempt_id TEXT NOT NULL PRIMARY KEY REFERENCES assistant_attempt(id),
  retrieval_status TEXT,
  retrieval_reason TEXT,
  indexed_revisions INTEGER,
  total_revisions INTEGER,
  sources_result TEXT
);
CREATE TABLE IF NOT EXISTS consulted_passage (
  attempt_id TEXT NOT NULL REFERENCES assistant_attempt(id),
  position INTEGER NOT NULL CHECK(position >= 1),
  source_id INTEGER NOT NULL,
  revision_id INTEGER NOT NULL,
  passage_id INTEGER NOT NULL,
  start_utf16 INTEGER NOT NULL CHECK(start_utf16 >= 0),
  end_utf16 INTEGER NOT NULL CHECK(end_utf16 > start_utf16),
  PRIMARY KEY(attempt_id, position)
);

allMessages:
SELECT * FROM message ORDER BY id;

insertMessage:
INSERT INTO message(text, created_at) VALUES (?, ?);

linkUserTurn:
UPDATE message SET turn_id = id WHERE id = ?;

insertAssistant:
INSERT INTO message(text, created_at, role, turn_id, generation_id) VALUES (?, ?, 'ASSISTANT', ?, ?);

attempts:
SELECT * FROM assistant_attempt ORDER BY user_id, rowid;

startAttempt:
INSERT INTO assistant_attempt(id, user_id, epoch, status, context_epoch)
VALUES (?, ?, ?, 'PENDING', coalesce((SELECT epoch FROM context_eligibility WHERE id = 1), 0));

attemptContext:
SELECT context_epoch FROM assistant_attempt WHERE id = ?;

finishAttempt:
UPDATE assistant_attempt SET status = ?, error = ? WHERE id = ? AND status = 'PENDING';

deletePendingAttempt:
DELETE FROM assistant_attempt WHERE id = ? AND status = 'PENDING';

reconcileAttempts:
UPDATE assistant_attempt SET status = 'INTERRUPTED' WHERE status = 'PENDING';

clearAttempts:
DELETE FROM assistant_attempt;

messageScopes:
SELECT message_id, scope FROM message_scope ORDER BY message_id;

writeMessageScope:
INSERT OR REPLACE INTO message_scope(message_id, scope) VALUES (?, ?);

clearMessageScopes:
DELETE FROM message_scope;

insertGrounding:
INSERT INTO attempt_grounding(attempt_id, retrieval_status, retrieval_reason, indexed_revisions, total_revisions, sources_result)
VALUES (?, ?, ?, ?, ?, ?);

groundings:
SELECT * FROM attempt_grounding;

clearGroundings:
DELETE FROM attempt_grounding;

insertConsulted:
INSERT INTO consulted_passage(attempt_id, position, source_id, revision_id, passage_id, start_utf16, end_utf16)
VALUES (?, ?, ?, ?, ?, ?, ?);

consultedPassages:
SELECT * FROM consulted_passage ORDER BY attempt_id, position;

clearConsulted:
DELETE FROM consulted_passage;

indexMessage:
INSERT INTO message_search(docid, text) VALUES (last_insert_rowid(), ?);

search:
SELECT message.* FROM message JOIN message_search ON message.id = message_search.docid
WHERE message_search.text MATCH ? ORDER BY message.id;

readDraft:
SELECT text FROM draft WHERE id = 1;

writeDraft:
INSERT OR REPLACE INTO draft(id, text) VALUES (1, ?);

clearMessages:
DELETE FROM message;

clearSearch:
DELETE FROM message_search;
