CREATE TABLE message (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  text TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  role TEXT NOT NULL DEFAULT 'USER',
  turn_id INTEGER,
  generation_id TEXT UNIQUE
);

CREATE TABLE assistant_attempt (
  id TEXT NOT NULL PRIMARY KEY,
  user_id INTEGER NOT NULL REFERENCES message(id),
  epoch INTEGER NOT NULL,
  status TEXT NOT NULL,
  error TEXT
);

CREATE TABLE draft (
  id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
  text TEXT NOT NULL
);

CREATE VIRTUAL TABLE message_search USING fts4(text TEXT);

CREATE INDEX message_created_at ON message(created_at);

allMessages:
SELECT * FROM message ORDER BY id;

insertMessage:
INSERT INTO message(text, created_at) VALUES (?, ?);

linkUserTurn:
UPDATE message SET turn_id = id WHERE id = ?;

insertAssistant:
INSERT INTO message(text, created_at, role, turn_id, generation_id) VALUES (?, ?, 'ASSISTANT', ?, ?);

attempts:
SELECT * FROM assistant_attempt ORDER BY user_id, rowid;

startAttempt:
INSERT INTO assistant_attempt(id, user_id, epoch, status) VALUES (?, ?, ?, 'PENDING');

finishAttempt:
UPDATE assistant_attempt SET status = ?, error = ? WHERE id = ? AND status = 'PENDING';

reconcileAttempts:
UPDATE assistant_attempt SET status = 'INTERRUPTED' WHERE status = 'PENDING';

clearAttempts:
DELETE FROM assistant_attempt;

indexMessage:
INSERT INTO message_search(docid, text) VALUES (last_insert_rowid(), ?);

search:
SELECT message.* FROM message JOIN message_search ON message.id = message_search.docid
WHERE message_search.text MATCH ? ORDER BY message.id;

readDraft:
SELECT text FROM draft WHERE id = 1;

writeDraft:
INSERT OR REPLACE INTO draft(id, text) VALUES (1, ?);

clearMessages:
DELETE FROM message;

clearSearch:
DELETE FROM message_search;
